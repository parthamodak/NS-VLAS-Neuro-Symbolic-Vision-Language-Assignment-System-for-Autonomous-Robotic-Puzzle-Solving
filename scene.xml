<mujoco model="ur3e">

  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="ur3e">

      <material specular="0.5" shininess="0.25"/>

      <joint axis="0 1 0"
             range="-6.28319 6.28319"
             armature="0.1"/>

      <general gaintype="fixed"
               biastype="affine"
               ctrlrange="-6.2831 6.2831"/>

      <default class="size2">
        <general gainprm="1000"
                 biasprm="0 -1000 -200"
                 forcerange="-56 56"/>
      </default>

      <default class="size1">
        <default class="size1_limited">

          <joint range="-3.14159 3.14159"/>

          <general gainprm="500"
                   biasprm="0 -500 -100"
                   ctrlrange="-3.14159 3.14159"
                   forcerange="-28 28"/>

        </default>
      </default>

      <default class="size0">
        <general gainprm="200"
                 biasprm="0 -200 -40"
                 forcerange="-12 12"/>
      </default>

      <default class="visual">
        <geom type="mesh"
              contype="0"
              conaffinity="0"
              group="2"/>
      </default>

      <default class="collision">
        <geom type="capsule"
              group="3"/>

        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>

      <site size="0.001"
            rgba="0.5 0.5 0.5 0.3"
            group="4"/>

    </default>
  </default>


  <asset>

    <material class="ur3e"
              name="black"
              rgba="0.033 0.033 0.033 1"/>

    <material class="ur3e"
              name="jointgray"
              rgba="0.278 0.278 0.278 1"/>

    <material class="ur3e"
              name="linkgray"
              rgba="0.82 0.82 0.82 1"/>

    <material class="ur3e"
              name="urblue"
              rgba="0.49 0.678 0.8 1"/>

    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>

    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>

    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>

    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>

    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>

    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>

    <mesh file="wrist3.obj"/>

  </asset>


  <worldbody>

    <!-- ===================================================== -->
    <!-- FLOOR -->
    <!-- ===================================================== -->

    <geom name="floor"
          type="plane"
          size="5 5 0.1"
          pos="0 0 -1"
          rgba="0.25 0.25 0.25 1"/>


    <!-- ===================================================== -->
    <!-- TABLE -->
    <!-- ===================================================== -->

    <body name="table">

      <geom name="table_top"
            type="box"
            size="0.8 0.6 0.05"
            pos="0 0 -0.05"
            rgba="0.55 0.35 0.20 1"/>

      <geom name="table_leg_1"
            type="box"
            size="0.05 0.05 0.45"
            pos="-0.7 -0.5 -0.55"
            rgba="0.55 0.35 0.20 1"/>

      <geom name="table_leg_2"
            type="box"
            size="0.05 0.05 0.45"
            pos="0.7 -0.5 -0.55"
            rgba="0.55 0.35 0.20 1"/>

      <geom name="table_leg_3"
            type="box"
            size="0.05 0.05 0.45"
            pos="-0.7 0.5 -0.55"
            rgba="0.55 0.35 0.20 1"/>

      <geom name="table_leg_4"
            type="box"
            size="0.05 0.05 0.45"
            pos="0.7 0.5 -0.55"
            rgba="0.55 0.35 0.20 1"/>

      <!-- Existing robot mounting plate -->
      <geom name="robot_mounting_plate"
            type="cylinder"
            size="0.16 0.025"
            pos="0 0 -0.025"
            rgba="0.15 0.15 0.15 1"/>

    </body>


    <!-- ===================================================== -->
    <!-- LIGHT -->
    <!-- ===================================================== -->

    <light name="spotlight"
           mode="targetbodycom"
           target="wrist_3_link"
           pos="0 -1 2"/>


    <!-- ===================================================== -->
    <!-- UR3e -->
    <!-- ===================================================== -->

    <body name="base"
          childclass="ur3e">

      <inertial mass="2"
                pos="0 0 0"
                diaginertia="0.0030532 0.0030532 0.005625"/>

      <geom mesh="base_0"
            material="jointgray"
            class="visual"/>

      <geom mesh="base_1"
            material="black"
            class="visual"/>


      <!-- Shoulder -->
      <body name="shoulder_link"
            pos="0 0 0.152">

        <inertial mass="2"
                  pos="0 0 0"
                  diaginertia="0.00809316 0.00809316 0.005625"/>

        <joint name="shoulder_pan_joint"
               class="size2"
               axis="0 0 1"/>

        <geom mesh="shoulder_0"
              material="urblue"
              class="visual"/>

        <geom mesh="shoulder_1"
              material="black"
              class="visual"/>

        <geom mesh="shoulder_2"
              material="jointgray"
              class="visual"/>

        <geom class="collision"
              size="0.047 0.05"
              pos="0 0 -0.032"/>


        <!-- Upper arm -->
        <body name="upper_arm_link"
              pos="0 0.12 0"
              quat="1 0 1 0">

          <inertial mass="3.42"
                    pos="0 0 0.122"
                    diaginertia="0.0217285 0.0217285 0.00961875"/>

          <joint name="shoulder_lift_joint"
                 class="size2"/>

          <geom mesh="upperarm_0"
                material="black"
                class="visual"/>

          <geom mesh="upperarm_1"
                material="urblue"
                class="visual"/>

          <geom mesh="upperarm_2"
                material="jointgray"
                class="visual"/>

          <geom mesh="upperarm_3"
                material="linkgray"
                class="visual"/>

          <geom class="collision"
                size="0.046 0.06"
                pos="0 -0.04 0"
                quat="1 1 0 0"/>

          <geom class="collision"
                size="0.038 0.11"
                pos="0 0 0.12"/>


          <!-- Forearm -->
          <body name="forearm_link"
                pos="0 -0.093 0.244">

            <inertial mass="1.26"
                      pos="0 0 0.10625"
                      diaginertia="0.00654457 0.00654457 0.00354375"/>

            <joint name="elbow_joint"
                   class="size1_limited"/>

            <geom mesh="forearm_0"
                  material="urblue"
                  class="visual"/>

            <geom mesh="forearm_1"
                  material="linkgray"
                  class="visual"/>

            <geom mesh="forearm_2"
                  material="black"
                  class="visual"/>

            <geom mesh="forearm_3"
                  material="jointgray"
                  class="visual"/>

            <geom class="collision"
                  size="0.038 0.048"
                  pos="0 0.062 0"
                  quat="1 1 0 0"/>

            <geom class="collision"
                  size="0.032 0.103"
                  pos="0 0 0.11"/>


            <!-- Wrist 1 -->
            <body name="wrist_1_link"
                  pos="0.0005 0 0.2125"
                  quat="1 0 1 0">

              <inertial mass="0.8"
                        pos="0 0.104 0"
                        diaginertia="0.00225 0.002085 0.002085"/>

              <joint name="wrist_1_joint"
                     class="size0"/>

              <geom mesh="wrist1_0"
                    material="jointgray"
                    class="visual"/>

              <geom mesh="wrist1_1"
                    material="urblue"
                    class="visual"/>

              <geom mesh="wrist1_2"
                    material="black"
                    class="visual"/>

              <geom class="collision"
                    size="0.032 0.05"
                    pos="0 0.045 0"
                    quat="1 1 0 0"/>


              <!-- Wrist 2 -->
              <body name="wrist_2_link"
                    pos="0 0.104 0">

                <inertial mass="0.8"
                          pos="0 0 0.085"
                          diaginertia="0.00225 0.002085 0.002085"/>

                <joint name="wrist_2_joint"
                       axis="0 0 1"/>

                <geom mesh="wrist2_0"
                      material="jointgray"
                      class="visual"/>

                <geom mesh="wrist2_1"
                      material="black"
                      class="visual"/>

                <geom mesh="wrist2_2"
                      material="urblue"
                      class="visual"/>

                <geom class="collision"
                      size="0.032 0.05"
                      pos="0 0 0.035"/>

                <geom class="collision"
                      size="0.032 0.027"
                      pos="0 0.01 0.085"
                      quat="1 1 0 0"/>


                <!-- Wrist 3 -->
                <body name="wrist_3_link"
                      pos="0 0 0.085">

                  <inertial mass="0.35"
                            pos="0 0.0715 0"
                            quat="1 0 0 1"
                            diaginertia="0.0001792 0.000136267 0.000136267"/>

                  <joint name="wrist_3_joint"/>

                  <geom mesh="wrist3"
                        material="linkgray"
                        class="visual"/>

                  <geom class="eef_collision"
                        size="0.032 0.023"
                        pos="0 0.07 0"
                        quat="1 1 0 0"/>


                  <!-- ================================================= -->
                  <!-- EXISTING ATTACHMENT SITE -->
                  <!-- ================================================= -->

                  <site name="attachment_site"
                        pos="0 0.09215 0"
                        quat="-1 1 0 0"/>


                  <!-- ================================================= -->
                  <!-- TWO-FINGER GRIPPER -->
                  <!-- ================================================= -->

                  <!-- Gripper palm -->
                  <body name="gripper_base"
                        pos="0 0.09215 0"
                        quat="-1 1 0 0">

                    <geom name="gripper_palm"
                          type="box"
                          size="0.045 0.035 0.025"
                          pos="0 0 0"
                          rgba="0.12 0.12 0.12 1"
                          mass="0.15"/>


                    <!-- Left finger -->
                    <body name="left_finger"
                          pos="-0.055 0 0">

                      <joint name="left_finger_joint"
                             type="slide"
                             axis="1 0 0"
                             range="0 0.045"
                             damping="2"/>

                      <geom name="left_finger"
                            type="box"
                            size="0.012 0.025 0.06"
                            pos="0 0 0.06"
                            rgba="0.2 0.2 0.2 1"
                            friction="1.5 0.5 0.05"
                            mass="0.08"/>

                      <geom name="left_finger_pad"
                            type="box"
                            size="0.006 0.027 0.045"
                            pos="0.012 0 0.06"
                            rgba="0.35 0.35 0.35 1"
                            friction="2 0.5 0.05"
                            mass="0.03"/>

                    </body>


                    <!-- Right finger -->
                    <body name="right_finger"
                          pos="0.055 0 0">

                      <joint name="right_finger_joint"
                             type="slide"
                             axis="-1 0 0"
                             range="0 0.045"
                             damping="2"/>

                      <geom name="right_finger"
                            type="box"
                            size="0.012 0.025 0.06"
                            pos="0 0 0.06"
                            rgba="0.2 0.2 0.2 1"
                            friction="1.5 0.5 0.05"
                            mass="0.08"/>

                      <geom name="right_finger_pad"
                            type="box"
                            size="0.006 0.027 0.045"
                            pos="-0.012 0 0.06"
                            rgba="0.35 0.35 0.35 1"
                            friction="2 0.5 0.05"
                            mass="0.03"/>

                    </body>

                  </body>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

  </worldbody>


  <!-- ===================================================== -->
  <!-- UR3e ACTUATORS -->
  <!-- ===================================================== -->

  <actuator>

    <general class="size2"
             name="shoulder_pan"
             joint="shoulder_pan_joint"/>

    <general class="size2"
             name="shoulder_lift"
             joint="shoulder_lift_joint"/>

    <general class="size1_limited"
             name="elbow"
             joint="elbow_joint"/>

    <general class="size0"
             name="wrist_1"
             joint="wrist_1_joint"/>

    <general class="size0"
             name="wrist_2"
             joint="wrist_2_joint"/>

    <general class="size0"
             name="wrist_3"
             joint="wrist_3_joint"/>


    <!-- Gripper finger actuators -->

    <position name="left_gripper"
              joint="left_finger_joint"
              kp="300"
              ctrlrange="0 0.045"/>

    <position name="right_gripper"
              joint="right_finger_joint"
              kp="300"
              ctrlrange="0 0.045"/>

  </actuator>


  <!-- ===================================================== -->
  <!-- HOME POSITION -->
  <!-- ===================================================== -->

  <keyframe>

    <key name="home"
          qpos="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 0 0"
          ctrl="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 0 0"/>

  </keyframe>

</mujoco>